<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.garethevans.church.opensongtablet.customviews.MyImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/image"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.garethevans.church.opensongtablet.customviews.MyMaterialSimpleTextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:padding="0dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_medium"
            tools:text="Main text" />

        <com.garethevans.church.opensongtablet.customviews.MyMaterialSimpleTextView
            android:id="@+id/hintView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:padding="0dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/hintTextColor"
            android:textSize="@dimen/text_small"
            tools:text="Info text that might span across multiple lines and needs to be expandable."/>

    </LinearLayout>

    <!-- Expand / Collapse Drop Down Arrow -->
    <com.garethevans.church.opensongtablet.customviews.MyImageView
        android:id="@+id/expandArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/button"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:src="@android:drawable/arrow_down_float"
        android:visibility="gone"/>

    <com.garethevans.church.opensongtablet.customviews.MyImageView
        android:id="@+id/checkMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/set"
        android:paddingStart="16dp"
        android:paddingEnd="0dp"
        android:src="@drawable/check"
        app:tint="?attr/colorOnPrimary"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/checkBoxHolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <com.garethevans.church.opensongtablet.customviews.MyMaterialCheckbox
            android:id="@+id/checkBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@null"/>

    </FrameLayout>

    <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
        android:id="@+id/endActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/button"
        android:visibility="gone"/>
</LinearLayout>