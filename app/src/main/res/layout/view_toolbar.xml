<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionBarBackground"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:minHeight="?attr/actionBarSize">

    <LinearLayout
        android:id="@+id/metronomeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/batterySpace"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/beat1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat11"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat13"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/beat16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <ImageView
        android:id="@+id/setIcon"
        android:layout_width="16dp"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/set"
        android:visibility="visible"
        app:srcCompat="@drawable/check"
        app:tint="?attr/colorOnPrimary" />

    <LinearLayout
        android:id="@+id/songandauthor"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:layout_alignEnd="@+id/metronomeLayout"
        android:layout_toEndOf="@+id/setIcon"
        android:background="@color/dark_tuner_red"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/songtitle_ab"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_large"
                tools:text="Title" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/songkey_ab"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:gravity="bottom"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_large"
                tools:text=" (Key)" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/songcapo_ab"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:gravity="bottom"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_large"
                tools:text=" [Capo]" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/songtempo_ab"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:gravity="bottom"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_large"
                tools:text=" 120bpm" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/songauthor_ab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:ellipsize="end"
            android:gravity="top"
            android:maxLines="1"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_medium"
            tools:text="Author" />

    </LinearLayout>

    <Space
        android:id="@+id/batterySpace"
        android:layout_width="12dp"
        android:layout_height="?attr/actionBarSize"
        android:layout_toStartOf="@+id/batteryholder" />


    <FrameLayout
        android:id="@+id/batteryholder"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/batteryimage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/time"
            android:visibility="visible" />

        <LinearLayout
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/batterycharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|bottom"
                android:includeFontPadding="false"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_xsmall"
                android:visibility="visible"
                tools:text="100%" />

            <TextClock
                android:id="@+id/digitalclock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:gravity="center_horizontal|top"
                android:includeFontPadding="false"
                android:maxWidth="50dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_xsmall"
                android:visibility="visible"
                tools:text="12:00" />
        </LinearLayout>

    </FrameLayout>
</RelativeLayout><!--
</com.google.android.material.appbar.MaterialToolbar>-->
