<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DefaultView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.garethevans.church.opensongtablet.customviews.MyMaterialTextView
                android:id="@+id/storageManage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/storage_local"
                android:hint="@string/storage_settings"
                app:size="large"/>
            <TableRow style="@style/DividerLine" />

            <LinearLayout
                android:id="@+id/syncWithConnectedLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <com.garethevans.church.opensongtablet.customviews.MyMaterialTextView
                    android:id="@+id/syncWithConnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync"
                    android:hint="@string/sync_info"
                    app:size="large"/>
                <TableRow
                    android:id="@+id/syncWithConnectedLine"
                    style="@style/DividerLine" />
            </LinearLayout>

            <com.garethevans.church.opensongtablet.customviews.MyMaterialTextView
                android:id="@+id/openChords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/openchords"
                android:hint="@string/openchords_info"
                app:size="large"/>
            <TableRow style="@style/DividerLine" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>