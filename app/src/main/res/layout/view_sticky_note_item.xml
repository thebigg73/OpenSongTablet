<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Note Text Input -->
    <com.garethevans.church.opensongtablet.customviews.MyMaterialEditText
        android:id="@+id/editNoteContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/song_notes"
        android:inputType="text|textMultiLine"
        android:minLines="3"
        app:endIconMode="clear_text" />

    <!-- Controls Row: Color Grid (2x2) and Delete Button -->
    <!-- 2x2 Grid for Color Choice FABs -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_gravity="center_vertical">

        <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
            android:id="@+id/btnColor1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:makeFlat="false"
            app:myFabSize="mini" />

        <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
            android:id="@+id/btnColor2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:myFabSize="mini" />

        <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
            android:id="@+id/btnColor3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:myFabSize="mini" />

        <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
            android:id="@+id/btnColor4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:myFabSize="mini" />
    </GridLayout>

    <!-- Delete Note Button -->
    <com.garethevans.church.opensongtablet.customviews.MyFloatingActionButton
        android:id="@+id/deleteBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="2dp"
        app:fabIcon="@drawable/delete"
        app:myFabSize="mini" />
</LinearLayout>